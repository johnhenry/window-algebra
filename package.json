{
  "name": "@johnhenry/window-algebra",
  "version": "0.0.0",
  "description": "A functional window manager for the browser: pure state updates, a small layout algebra that derives a presentation tree, and CSS (flex, grid, anchor positioning, container queries) as the final layout solver.",
  "type": "module",
  "main": "./src/index.mjs",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.mjs",
    "./browser": "./src/browser/index.mjs",
    "./algebra": "./src/algebra/nodes.mjs",
    "./transforms": "./src/algebra/transforms.mjs",
    "./layouts": "./src/layouts/index.mjs",
    "./css": "./src/css/compile.mjs",
    "./react": "./src/bindings/react.mjs",
    "./element": "./src/bindings/element.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "examples": "for f in examples/[0-9]*.mjs; do node \"$f\" || exit 1; done",
    "example:01": "node examples/01-state-derives-a-tree-that-compiles-to-css.mjs",
    "example:02": "node examples/02-bad-commands-are-rejected-and-history-replays.mjs",
    "example:03": "node examples/03-a-drop-edits-structure-per-layout.mjs",
    "example:04": "node examples/04-saved-state-migrates-and-newer-state-is-refused.mjs",
    "example:05": "node examples/05-rules-scratchpad-urgency-and-outputs-are-pure-policy.mjs",
    "example:06": "node examples/06-popup-snap-and-size-hint-math-needs-no-dom.mjs",
    "demo": "echo 'Serve the repo root with any static server and open /demo/ (the example hub). ES modules do not load from file://.'"
  },
  "keywords": [
    "window-manager",
    "tiling",
    "layout",
    "css-grid",
    "anchor-positioning",
    "functional",
    "reducer"
  ],
  "author": "John Henry",
  "license": "MIT",
  "homepage": "https://opensource.johnhenry.me/window-algebra/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/window-algebra.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/window-algebra/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
